APP_NAME="Laravel Lokal"
APP_ENV=local
APP_KEY=base64:U9JNF/SoxhZXk32duy6sNVx9+2fHs3XMEsCYVMRHgVs=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# --- DATABASE SQLITE LOKAL ---
DB_CONNECTION=sqlite
# DB_DATABASE tidak perlu diisi jika file ada di database/database.sqlite
# Tapi jika ingin eksplisit, gunakan path lengkap:
# DB_DATABASE=C:\Users\Axioo\Downloads\sharesa-digital\database\database.sqlite

# --- SESSION & CACHE ---
# Gunakan file di lokal agar tidak bentrok
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Pastikan ini pakai 'file', bukan yang lain

# Tambahkan ini untuk memastikan storage-nya benar di Windows
FILESYSTEM_DISK=local

# --- LOGGING ---
LOG_LEVEL=debug

# --- BROADCAST / VITE ---
# Paksa pakai HTTP biasa supaya tidak muncul "Unsupported SSL Request"
PUSHER_SCHEME=http
PUSHER_PORT=80
VITE_PUSHER_SCHEME=http
VITE_PUSHER_PORT=80

# Matikan Cloudinary di lokal jika tidak ingin upload ke cloud saat testing
# CLOUDINARY_URL=

